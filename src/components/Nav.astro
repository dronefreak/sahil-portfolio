---
import { site } from '../data/site';
import Icon from './Icon.astro';
---

<header
  id="site-nav"
  data-scrolled="false"
  class="fixed inset-x-0 top-0 z-50 border-b border-transparent transition-colors duration-300 data-[scrolled=true]:border-white/10 data-[scrolled=true]:bg-ink/90 data-[scrolled=true]:backdrop-blur-md"
>
  <nav class="mx-auto flex h-16 max-w-6xl items-center justify-between px-6" aria-label="Main">
    <a href="#home" class="text-gradient-sport whitespace-nowrap font-display text-2xl font-bold uppercase tracking-wide">
      {site.name}
    </a>

    <ul class="hidden items-center gap-8 lg:flex">
      {site.nav.map((link) => (
        <li>
          <a
            href={link.href}
            data-nav-link
            class="font-display text-base font-semibold uppercase tracking-wider text-chalk/60 transition-colors duration-200 hover:text-chalk aria-[current=true]:text-amber focus-visible:outline-2 focus-visible:outline-amber"
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>

    <div class="hidden items-center gap-3 lg:flex">
      <a href={site.links.resume} download="Sahil-Kolhe-Resume.pdf" class="btn-secondary !px-4 !py-1.5 !text-sm">
        <Icon name="download" class="size-4" />
        Resume
      </a>
      <a href={site.links.topmate} target="_blank" rel="noopener" class="btn-secondary !px-4 !py-1.5 !text-sm">
        Book a call
      </a>
    </div>

    <button
      id="nav-toggle"
      type="button"
      class="flex size-9 flex-col items-center justify-center gap-1.5 lg:hidden"
      aria-label="Open menu"
      aria-expanded="false"
      aria-controls="nav-menu"
    >
      <span class="bar block h-0.5 w-5 bg-chalk/80 transition-all duration-300"></span>
      <span class="bar block h-0.5 w-5 bg-chalk/80 transition-all duration-300"></span>
      <span class="bar block h-0.5 w-5 bg-chalk/80 transition-all duration-300"></span>
    </button>
  </nav>

  <div id="nav-menu" hidden class="border-b border-white/10 bg-ink/95 backdrop-blur-xl lg:hidden">
    <ul class="flex flex-col gap-1 px-6 py-4">
      {site.nav.map((link) => (
        <li>
          <a
            href={link.href}
            data-nav-link
            class="block py-2 font-display text-lg font-semibold uppercase tracking-wider text-chalk/75 aria-[current=true]:text-amber"
          >
            {link.label}
          </a>
        </li>
      ))}
      <li>
        <a href={site.links.resume} download="Sahil-Kolhe-Resume.pdf" class="flex items-center gap-2 py-2 font-display text-lg font-semibold uppercase tracking-wider text-chalk/75">
          <Icon name="download" /> Resume
        </a>
      </li>
      <li>
        <a href={site.links.topmate} target="_blank" rel="noopener" class="btn-primary mt-2">Book a call</a>
      </li>
    </ul>
  </div>
</header>

<script>
  const header = document.getElementById('site-nav')!;
  const toggle = document.getElementById('nav-toggle')!;
  const menu = document.getElementById('nav-menu')!;
  const bars = toggle.querySelectorAll<HTMLElement>('.bar');

  // Solid background once the page has scrolled
  const onScroll = () => header.dataset.scrolled = String(window.scrollY > 60);
  onScroll();
  addEventListener('scroll', onScroll, { passive: true });

  // Mobile menu
  const setOpen = (open: boolean) => {
    menu.hidden = !open;
    toggle.setAttribute('aria-expanded', String(open));
    toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    bars[0].style.transform = open ? 'translateY(8px) rotate(45deg)' : '';
    bars[1].style.opacity = open ? '0' : '';
    bars[2].style.transform = open ? 'translateY(-8px) rotate(-45deg)' : '';
    // Menu background only matters over content, so make the bar solid while open
    header.classList.toggle('bg-ink', open);
  };
  toggle.addEventListener('click', () => setOpen(menu.hidden));
  menu.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).closest('a')) setOpen(false);
  });
  addEventListener('keydown', (e) => e.key === 'Escape' && setOpen(false));

  // Highlight the link for the section currently in view
  const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-nav-link]')];
  const sections = links
    .map((a) => document.querySelector(a.getAttribute('href')!))
    .filter((el): el is Element => !!el);
  const observer = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        if (!entry.isIntersecting) continue;
        for (const a of links) a.setAttribute('aria-current', String(a.getAttribute('href') === `#${entry.target.id}`));
      }
    },
    { rootMargin: '-45% 0px -50% 0px' },
  );
  sections.forEach((s) => observer.observe(s));
</script>
