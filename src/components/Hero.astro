---
import { Image } from 'astro:assets';
import photo from '../assets/avatar-options/option-07.jpg';
import Constellation from './Constellation.astro';
import Icon from './Icon.astro';
import LogoStrip from './LogoStrip.astro';
import { site } from '../data/site';

const socials = [
  { label: 'LinkedIn', href: site.links.linkedin, icon: 'linkedin' },
  { label: 'Instagram', href: site.links.instagram, icon: 'instagram' },
  { label: 'Email', href: site.links.email, icon: 'mail' },
  { label: 'Topmate', href: site.links.topmate, icon: 'calendar' },
] as const;
---

<section id="home" class="relative overflow-hidden bg-ink text-chalk">
  <!-- Background grid, faded out toward the edges, plus a corner glow -->
  <div class="hero-grid absolute inset-0" aria-hidden="true"></div>
  <div
    class="absolute inset-0"
    aria-hidden="true"
    style="background: radial-gradient(ellipse 80% 60% at 50% 50%, transparent 30%, #201c1c 100%)"
  >
  </div>
  <div
    class="pointer-events-none absolute -left-32 -top-32 size-[500px] rounded-full"
    aria-hidden="true"
    style="background: radial-gradient(circle, rgba(71,88,214,0.22) 0%, transparent 70%)"
  >
  </div>

  <div class="relative mx-auto flex min-h-[calc(100svh-7rem)] max-w-6xl items-center px-6 pb-16 pt-28">
    <div class="grid w-full items-center gap-10 md:grid-cols-[minmax(0,1.15fr)_minmax(0,1fr)] md:gap-12">
      <!-- Left: text -->
      <div class="max-w-2xl">
        <div class="reveal mb-8 flex flex-wrap items-center gap-x-4 gap-y-3" style="--d: 0.1s">
          <!-- Close-up crop: zoom in on the face, then centre it in the circle -->
          <div class="size-16 shrink-0 overflow-hidden rounded-full border-2 border-signal ring-4 ring-royal/30 sm:size-20">
            <Image
              src={photo}
              alt={`Portrait of ${site.name}`}
              width={640}
              class="size-full object-cover object-[50%_30%]"
              style="transform-origin: 30% 41%; transform: translate(20%, 9%) scale(3)"
              loading="eager"
            />
          </div>
          <div class="inline-flex items-center gap-2 rounded-full border border-royal/50 bg-royal/10 px-3.5 py-1 font-display text-xs font-semibold uppercase tracking-[0.12em] text-chalk">
            <span class="pulse-dot inline-block size-1.5 rounded-full bg-signal"></span>
            {site.badge.join(' · ')}
          </div>
        </div>

        <h1 class="reveal mb-6 font-display text-5xl font-bold uppercase leading-[0.95] tracking-tight text-white sm:text-6xl lg:text-7xl" style="--d: 0.2s">
          {site.headline.lead}
          <span class="text-gradient-sport block">{site.headline.accent}</span>
        </h1>

        <div class="reveal mb-6 flex h-7 items-center gap-2 font-display text-lg font-semibold uppercase tracking-wider text-amber md:text-xl" style="--d: 0.28s">
          <span class="text-amber/50" aria-hidden="true">&gt;</span>
          <span id="role" aria-hidden="true">{site.roles[0]}</span><span class="caret" aria-hidden="true"></span>
          <span class="sr-only">{site.roles.join(', ')}</span>
        </div>

        <p class="reveal mb-10 flex max-w-xl flex-wrap items-center gap-y-1 text-sm text-chalk/65 md:text-base" style="--d: 0.35s">
          {site.focus.map((kw, i) => (
            <span class="flex items-center">
              <span>{kw}</span>
              {i < site.focus.length - 1 && <span class="mx-2.5 select-none text-signal/60" aria-hidden="true">|</span>}
            </span>
          ))}
        </p>

        <div class="reveal mb-9 flex flex-wrap gap-3" style="--d: 0.45s">
          <a href="#experience" class="btn-primary">
            View experience
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"></path></svg>
          </a>
          <a href={site.links.topmate} target="_blank" rel="noopener" class="btn-secondary">Book a call</a>
        </div>

        <div class="reveal flex flex-wrap items-center gap-y-1" style="--d: 0.55s">
          {socials.map((s, i) => (
            <>
              <a
                href={s.href}
                target={s.href.startsWith('http') ? '_blank' : undefined}
                rel={s.href.startsWith('http') ? 'noopener noreferrer' : undefined}
                class="flex items-center gap-1.5 whitespace-nowrap pr-1.5 text-chalk/50 transition-colors duration-200 hover:text-amber focus-visible:outline-2 focus-visible:outline-amber"
              >
                <Icon name={s.icon} />
                <span class="text-xs sm:text-sm">{s.label}</span>
              </a>
              {i < socials.length - 1 && <span class="select-none pr-1.5 text-chalk/20" aria-hidden="true">|</span>}
            </>
          ))}
        </div>
      </div>

      <!-- Right: profile card with photo and stats -->
      <div class="reveal glass-card w-full p-5 md:max-w-lg md:justify-self-end md:p-6" style="--d: 0.3s">
        <div class="mb-3 flex items-center justify-between font-display text-[11px] font-semibold uppercase tracking-[0.14em]">
          <span class="text-chalk/40">Skills &amp; stats</span>
        </div>

        <div class="overflow-hidden rounded-lg bg-ink/40">
          <Constellation />
        </div>

        <div class="mt-4 space-y-3">
          {site.statGroups.map((group) => (
            <div class="grid grid-cols-3 gap-2 lg:grid-cols-[84px_repeat(3,minmax(0,1fr))] lg:items-center">
              <h3 class="col-span-3 font-display text-[11px] font-semibold uppercase tracking-[0.14em] text-amber lg:col-span-1">
                {group.title}
              </h3>
              {group.items.map((stat) => (
                <div class="flex flex-col justify-center rounded-lg border border-royal/30 bg-white/[0.02] px-1.5 py-3 text-center">
                  <div class="text-gradient-sport font-display text-2xl font-bold leading-tight tabular-nums">{stat.value}</div>
                  <div class="mt-1 text-[10px] uppercase leading-tight tracking-wider text-chalk/45">{stat.label}</div>
                </div>
              ))}
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>

  <LogoStrip />
</section>

<script>
  // Typewriter for the role line. Static first role if the user prefers reduced motion.
  const el = document.getElementById('role');
  const roles = (el?.parentElement?.querySelector('.sr-only')?.textContent ?? '').split(', ').filter(Boolean);
  if (el && roles.length > 1 && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    let r = 0;
    let i = roles[0].length;
    let deleting = true;
    const tick = () => {
      const word = roles[r];
      if (deleting) {
        i--;
        if (i <= 0) {
          deleting = false;
          r = (r + 1) % roles.length;
          i = 0;
        }
      } else {
        i++;
        if (i >= roles[r].length) {
          deleting = true;
          el.textContent = roles[r];
          return setTimeout(tick, 1800);
        }
      }
      el.textContent = (deleting ? word : roles[r]).slice(0, i);
      setTimeout(tick, deleting ? 55 : 45);
    };
    setTimeout(tick, 1800);
  }
</script>
