---
import { education } from '../data/education';
---

<section id="education" class="bg-chalk px-6 py-20 text-ink">
  <div class="mx-auto max-w-6xl">
    <p class="mb-3 flex items-center gap-3 font-display text-sm font-semibold uppercase tracking-[0.3em] text-ink/60">
      <span class="h-0.5 w-8 bg-amber" aria-hidden="true"></span>Education
    </p>
    <h2 class="mb-10 font-display text-4xl font-bold uppercase leading-none sm:text-5xl">
      Where I <span class="text-royal">studied</span>
    </h2>

    <ul class="grid gap-5 md:grid-cols-2">
      {education.map((d) => (
        <li class="rounded-xl border-t-4 border-signal bg-ink p-6 text-chalk">
          <p class="mb-2 font-display text-sm font-semibold uppercase tracking-[0.14em] text-amber">
            {d.level} <span class="text-chalk/60">· {d.dates}</span>
          </p>
          <h3 class="font-display text-2xl font-bold uppercase leading-tight text-white sm:text-3xl">{d.title}</h3>
          {d.detail && <p class="mt-1 text-chalk/80">{d.detail}</p>}
          <p class="mt-3 text-chalk/70">
            {d.school}{d.place && <span class="text-chalk/60"> · {d.place}</span>}
          </p>
          {d.activities && (
            <ul class="mt-4 flex flex-wrap gap-2" aria-label="Skills and activities">
              {d.activities.map((a) => (
                <li class="rounded-full border border-royal/50 bg-royal/10 px-3 py-1 text-xs text-chalk/80">{a}</li>
              ))}
            </ul>
          )}
        </li>
      ))}
    </ul>
  </div>
</section>
