---
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';

// Every candidate photo, numbered by file name (option-01.jpg ...). Pick a number.
const files = import.meta.glob<{ default: ImageMetadata }>('../../assets/avatar-options/*.jpg', { eager: true });
const options = Object.entries(files)
  .sort(([a], [b]) => a.localeCompare(b))
  .map(([path, mod]) => ({ n: path.match(/option-(\d+)/)![1], img: mod.default }));
---

<Layout title="Avatar options">
  <main class="min-h-screen bg-ink px-6 py-10 text-chalk">
    <h1 class="mb-2 font-display text-4xl font-bold uppercase text-white">Avatar options</h1>
    <p class="mb-8 text-chalk/60">Left: how it looks as the round avatar. Right: the full photo. Tell me the number.</p>
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {options.map(({ n, img }) => (
        <div class="flex items-center gap-4 rounded-xl border border-royal/30 p-4">
          <span class="font-display text-3xl font-bold text-amber">{n}</span>
          <Image src={img} width={160} alt={`Option ${n} as avatar`} class="size-20 shrink-0 rounded-full border-2 border-signal object-cover object-[50%_25%] ring-4 ring-royal/30" />
          <Image src={img} width={240} alt={`Option ${n} full photo`} class="h-40 w-auto rounded-lg object-contain" />
        </div>
      ))}
    </div>
  </main>
</Layout>
