---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Page not found | Sahil Kolhe" description="This page doesn't exist.">
  <main id="main" class="relative flex min-h-svh items-center justify-center overflow-hidden bg-ink px-6 text-center text-chalk">
    <div class="hero-grid absolute inset-0" aria-hidden="true"></div>
    <div class="relative">
      <p class="font-display text-8xl font-bold leading-none text-gradient-sport sm:text-9xl">404</p>
      <h1 class="mt-4 font-display text-3xl font-bold uppercase text-white sm:text-4xl">Out of bounds</h1>
      <p class="mt-3 text-chalk/70">That page doesn’t exist.</p>
      <a href="/" class="btn-primary mt-8">Back to the pitch</a>
    </div>
  </main>
</Layout>
